# --- DEV (docker-compose.yml faqat Postgres ko'taradi) ---
POSTGRES_USER=zexn
POSTGRES_PASSWORD=zexn
POSTGRES_DB=zexn
# Host port. Kompyuterda boshqa Postgres 5432 ni band qilgan bo'lsa o'zgartir (DATABASE_URL ham).
POSTGRES_PORT=5432

# --- apps/server ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://zexn:zexn@localhost:5432/zexn?schema=public
# Vergul bilan bir nechta origin. Dev'da localhost:5173 avtomatik qo'shiladi.
CLIENT_ORIGIN=http://localhost:5173

# Kamida 32 belgili, bir-biridan farqli tasodifiy qiymatlar.
JWT_ACCESS_SECRET=dev-access-secret-change-me-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-chars
# Dev seed parollarini yozadi. Production .env faylida bu o'zgaruvchi bo'lmasin.
SEED_DEV_PASSWORDS=true
# TELEGRAM_BOT_TOKEN=

# --- apps/client ---
# Bo'sh bo'lsa client o'z origin'idagi /api ga yuboradi (dev'da Vite proxy, prod'da nginx).
VITE_API_URL=
