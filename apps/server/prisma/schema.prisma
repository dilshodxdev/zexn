// ZEXN - 1-bosqich: Center, User, Membership.
// Qoida: vaqt DB'da UTC (Postgres timestamptz), UI'da Asia/Tashkent.
// Tenant jadvallarida centerId bor; har so'rovda centerId filtri majburiy (docs/04-data-model.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// O'quv markazi = tenant. Har markaz o'z izolyatsiyalangan workspace'iga ega.
model Center {
  id        String   @id @default(cuid())
  name      String
  /// URL'da va loglarda ishlatiladigan qisqa unikal nom (masalan "itpark-xorazm")
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  testAttempts   TestAttempt[]
  knowledgeGaps  KnowledgeGap[]
  nextSteps      NextStep[]
  studentStats   StudentStats[]
  mentorMessages MentorMessage[]

  @@map("centers")
}

/// Odam (akkaunt). Markazga bog'liq emas - rol Membership orqali.
model User {
  id                 String   @id @default(cuid())
  fullName           String
  /// Login + parol usuli. Markaz admini yaratadi.
  login              String   @unique
  /// Telegram-only akkaunt bo'lishi mumkin, shuning uchun nullable.
  passwordHash       String?
  /// Telegram deep-link orqali bog'langan Telegram user ID.
  telegramId         BigInt?  @unique
  /// Vaqtinchalik parol bilan yaratilgan - birinchi kirishda almashtirish shart.
  mustChangePassword Boolean  @default(false)
  /// Biz (platforma egalari). Markazga bog'liq emas, tenant filtri unga ham qo'llanadi.
  isSuperAdmin       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  testAttempts   TestAttempt[]
  knowledgeGaps  KnowledgeGap[]
  nextSteps      NextStep[]
  studentStats   StudentStats?
  mentorMessages MentorMessage[]

  @@map("users")
}

/// Markaz ichidagi rol. Super admin bu yerda emas (User.isSuperAdmin).
enum Role {
  STUDENT
  TEACHER
  CENTER_ADMIN
}

/// User x Center x Role. Bitta odam bir markazda o'qituvchi, boshqasida admin bo'lishi mumkin.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  centerId  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  /// Bir odam bir markazda bitta rol.
  @@unique([userId, centerId])
  @@index([centerId, role])
  @@map("memberships")
}

/// Uzoq muddatli sessiya tokeni. Tokenning o'zi emas, SHA-256 hashi saqlanadi.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Subject {
  id       String  @id @default(cuid())
  title    String
  slug     String  @unique
  isActive Boolean @default(true)

  topics Topic[]

  @@map("subjects")
}

model Topic {
  id          String @id @default(cuid())
  subjectId   String
  title       String
  slug        String
  order       Int
  description String

  subject       Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  prerequisites TopicPrerequisite[] @relation("TopicPrerequisites")
  requiredBy    TopicPrerequisite[] @relation("TopicRequiredBy")
  materials     Material[]
  questions     Question[]
  tests         Test[]
  knowledgeGaps KnowledgeGap[]      @relation("GapTopic")
  rootGaps      KnowledgeGap[]      @relation("GapRootTopic")
  nextSteps     NextStep[]

  @@unique([subjectId, slug])
  @@index([subjectId, order])
  @@map("topics")
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String

  topic        Topic @relation("TopicPrerequisites", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite Topic @relation("TopicRequiredBy", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@map("topic_prerequisites")
}

model Material {
  id      String @id @default(cuid())
  topicId String
  title   String
  url     String
  kind    String

  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  nextSteps NextStep[]

  @@index([topicId])
  @@map("materials")
}

model Question {
  id              String @id @default(cuid())
  topicId         String
  text            String
  options         Json
  correctOptionId String
  difficulty      Int

  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  testQuestions TestQuestion[]
  answers       Answer[]

  @@index([topicId])
  @@map("questions")
}

model Test {
  id       String  @id @default(cuid())
  topicId  String
  title    String
  isActive Boolean @default(true)

  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  testQuestions TestQuestion[]
  attempts      TestAttempt[]

  @@index([topicId])
  @@map("tests")
}

model TestQuestion {
  testId     String
  questionId String
  order      Int

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@unique([testId, order])
  @@map("test_questions")
}

model TestAttempt {
  id         String    @id @default(cuid())
  centerId   String
  studentId  String
  testId     String
  score      Int
  correct    Int
  total      Int
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  center  Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test    Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers Answer[]
  gaps    KnowledgeGap[]

  @@index([centerId, studentId])
  @@index([testId])
  @@map("test_attempts")
}

model Answer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String
  isCorrect  Boolean

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("answers")
}

model KnowledgeGap {
  id          String   @id @default(cuid())
  centerId    String
  studentId   String
  topicId     String
  rootTopicId String?
  confidence  Float
  explanation String?
  attemptId   String?
  createdAt   DateTime @default(now())

  center    Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic     Topic        @relation("GapTopic", fields: [topicId], references: [id], onDelete: Cascade)
  rootTopic Topic?       @relation("GapRootTopic", fields: [rootTopicId], references: [id], onDelete: SetNull)
  attempt   TestAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  nextSteps NextStep[]

  @@index([centerId, studentId, topicId])
  @@map("knowledge_gaps")
}

model NextStep {
  id          String    @id @default(cuid())
  centerId    String
  studentId   String
  gapId       String?
  topicId     String
  materialId  String?
  instruction String
  status      String
  createdAt   DateTime  @default(now())
  doneAt      DateTime?

  center   Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student  User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gap      KnowledgeGap? @relation(fields: [gapId], references: [id], onDelete: SetNull)
  topic    Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  material Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([centerId, studentId, status, createdAt])
  @@map("next_steps")
}

model StudentStats {
  id             String    @id @default(cuid())
  centerId       String
  studentId      String    @unique
  xp             Int       @default(0)
  streakDays     Int       @default(0)
  streakRecord   Int       @default(0)
  lastActiveDate DateTime?
  achievements   Int       @default(0)

  center  Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([centerId, xp])
  @@map("student_stats")
}

model MentorMessage {
  id        String   @id @default(cuid())
  centerId  String
  studentId String
  role      String
  text      String
  createdAt DateTime @default(now())

  center  Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([centerId, studentId, createdAt])
  @@map("mentor_messages")
}
