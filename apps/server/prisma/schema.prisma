// ZEXN - 1-bosqich: Center, User, Membership.
// Qoida: vaqt DB'da UTC (Postgres timestamptz), UI'da Asia/Tashkent.
// Tenant jadvallarida centerId bor; har so'rovda centerId filtri majburiy (docs/04-data-model.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// O'quv markazi = tenant. Har markaz o'z izolyatsiyalangan workspace'iga ega.
model Center {
  id                    String    @id @default(cuid())
  name                  String
  /// URL'da va loglarda ishlatiladigan qisqa unikal nom (masalan "itpark-xorazm")
  slug                  String    @unique
  isActive              Boolean   @default(true)
  mentorSystemPrompt    String    @default("")
  promptUpdatedAt       DateTime?
  promptUpdatedByUserId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  promptUpdatedBy User? @relation("CenterPromptUpdatedBy", fields: [promptUpdatedByUserId], references: [id], onDelete: SetNull)

  memberships     Membership[]
  testAttempts    TestAttempt[]
  knowledgeGaps   KnowledgeGap[]
  nextSteps       NextStep[]
  studentStats    StudentStats[]
  mentorMessages  MentorMessage[]
  assignments     Assignment[]
  submissions     AssignmentSubmission[]
  studentSkills   StudentSkill[]
  studentPatterns StudentPattern[]
  skillHistories  SkillHistory[]
  interviews      InterviewSession[]

  @@map("centers")
}

/// Odam (akkaunt). Markazga bog'liq emas - rol Membership orqali.
model User {
  id                 String   @id @default(cuid())
  fullName           String
  /// Login + parol usuli. Markaz admini yaratadi.
  login              String   @unique
  /// Telegram-only akkaunt bo'lishi mumkin, shuning uchun nullable.
  passwordHash       String?
  /// Telegram deep-link orqali bog'langan Telegram user ID.
  telegramId         BigInt?  @unique
  /// Vaqtinchalik parol bilan yaratilgan - birinchi kirishda almashtirish shart.
  mustChangePassword Boolean  @default(false)
  /// Biz (platforma egalari). Markazga bog'liq emas, tenant filtri unga ham qo'llanadi.
  isSuperAdmin       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships             Membership[]
  refreshTokens           RefreshToken[]
  testAttempts            TestAttempt[]
  knowledgeGaps           KnowledgeGap[]
  nextSteps               NextStep[]
  studentStats            StudentStats?
  mentorMessages          MentorMessage[]
  createdAssignments      Assignment[]           @relation("AssignmentCreatedBy")
  assignmentSubmissions   AssignmentSubmission[] @relation("SubmissionStudent")
  reviewedSubmissions     AssignmentSubmission[] @relation("SubmissionReviewer")
  targetedAssignments     Assignment[]           @relation("AssignmentTarget")
  skills                  StudentSkill[]
  patterns                StudentPattern[]
  skillHistories          SkillHistory[]
  centerPromptsUpdated    Center[]               @relation("CenterPromptUpdatedBy")
  platformSettingsUpdated PlatformSetting[]
  interviews              InterviewSession[]

  @@map("users")
}

/// Platforma darajasidagi sozlamalar - bitta qator (id = "default"). Super admin tahrirlaydi.
model PlatformSetting {
  id                 String   @id @default("default")
  mentorSystemPrompt String   @default("")
  updatedByUserId    String?
  updatedAt          DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

/// Markaz ichidagi rol. Super admin bu yerda emas (User.isSuperAdmin).
enum Role {
  STUDENT
  TEACHER
  CENTER_ADMIN
}

/// User x Center x Role. Bitta odam bir markazda o'qituvchi, boshqasida admin bo'lishi mumkin.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  centerId  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  /// Bir odam bir markazda bitta rol.
  @@unique([userId, centerId])
  @@index([centerId, role])
  @@map("memberships")
}

/// Uzoq muddatli sessiya tokeni. Tokenning o'zi emas, SHA-256 hashi saqlanadi.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Subject {
  id       String  @id @default(cuid())
  title    String
  slug     String  @unique
  isActive Boolean @default(true)

  topics Topic[]

  @@map("subjects")
}

model Topic {
  id          String @id @default(cuid())
  subjectId   String
  title       String
  slug        String
  order       Int
  description String

  subject       Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  prerequisites TopicPrerequisite[] @relation("TopicPrerequisites")
  requiredBy    TopicPrerequisite[] @relation("TopicRequiredBy")
  materials     Material[]
  questions     Question[]
  tests         Test[]
  knowledgeGaps KnowledgeGap[]      @relation("GapTopic")
  rootGaps      KnowledgeGap[]      @relation("GapRootTopic")
  nextSteps     NextStep[]
  assignments   Assignment[]
  skills        Skill[]

  @@unique([subjectId, slug])
  @@index([subjectId, order])
  @@map("topics")
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String

  topic        Topic @relation("TopicPrerequisites", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite Topic @relation("TopicRequiredBy", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@map("topic_prerequisites")
}

model Material {
  id      String @id @default(cuid())
  topicId String
  title   String
  url     String
  kind    String

  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  nextSteps NextStep[]

  @@index([topicId])
  @@map("materials")
}

model Question {
  id              String @id @default(cuid())
  topicId         String
  text            String
  options         Json
  correctOptionId String
  difficulty      Int

  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  testQuestions TestQuestion[]
  answers       Answer[]

  @@index([topicId])
  @@map("questions")
}

model Test {
  id       String  @id @default(cuid())
  topicId  String
  title    String
  isActive Boolean @default(true)

  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  testQuestions TestQuestion[]
  attempts      TestAttempt[]

  @@index([topicId])
  @@map("tests")
}

model TestQuestion {
  testId     String
  questionId String
  order      Int

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@unique([testId, order])
  @@map("test_questions")
}

model TestAttempt {
  id         String    @id @default(cuid())
  centerId   String
  studentId  String
  testId     String
  score      Int
  correct    Int
  total      Int
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  center  Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test    Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers Answer[]
  gaps    KnowledgeGap[]

  @@index([centerId, studentId])
  @@index([testId])
  @@map("test_attempts")
}

model Answer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String
  isCorrect  Boolean

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("answers")
}

model KnowledgeGap {
  id          String   @id @default(cuid())
  centerId    String
  studentId   String
  topicId     String
  rootTopicId String?
  confidence  Float
  explanation String?
  attemptId   String?
  createdAt   DateTime @default(now())

  center    Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic     Topic        @relation("GapTopic", fields: [topicId], references: [id], onDelete: Cascade)
  rootTopic Topic?       @relation("GapRootTopic", fields: [rootTopicId], references: [id], onDelete: SetNull)
  attempt   TestAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  nextSteps NextStep[]

  @@index([centerId, studentId, topicId])
  @@map("knowledge_gaps")
}

model NextStep {
  id           String             @id @default(cuid())
  centerId     String
  studentId    String
  gapId        String?
  topicId      String
  materialId   String?
  instruction  String
  status       String
  createdAt    DateTime           @default(now())
  doneAt       DateTime?
  skillId      String?
  actionType   NextStepActionType @default(REVIEW_MATERIAL)
  priority     Int                @default(0)
  reason       String?
  assignmentId String?

  center     Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gap        KnowledgeGap? @relation(fields: [gapId], references: [id], onDelete: SetNull)
  topic      Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  material   Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  skill      Skill?        @relation(fields: [skillId], references: [id], onDelete: SetNull)
  assignment Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([centerId, studentId, status, createdAt])
  @@map("next_steps")
}

model StudentStats {
  id             String    @id @default(cuid())
  centerId       String
  studentId      String    @unique
  xp             Int       @default(0)
  streakDays     Int       @default(0)
  streakRecord   Int       @default(0)
  lastActiveDate DateTime?
  achievements   Int       @default(0)

  center  Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([centerId, xp])
  @@map("student_stats")
}

model MentorMessage {
  id        String   @id @default(cuid())
  centerId  String
  studentId String
  role      String
  text      String
  createdAt DateTime @default(now())

  center  Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([centerId, studentId, createdAt])
  @@map("mentor_messages")
}

enum AssignmentDifficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  DONE
}

enum PatternStatus {
  ACTIVE
  IMPROVING
  RESOLVED
}

enum NextStepActionType {
  TARGETED_TASK
  RETEST
  REVIEW_MATERIAL
}

enum SkillHistorySource {
  ATTEMPT
  SUBMISSION
  REVIEW
  INTERVIEW
  SEED
}

enum InterviewStatus {
  IN_PROGRESS
  DONE
  ABANDONED
}

model Assignment {
  id              String               @id @default(cuid())
  centerId        String
  topicId         String?
  skillId         String?
  targetStudentId String?
  title           String
  description     String
  difficulty      AssignmentDifficulty
  dueAt           DateTime
  resources       Json                 @default("[]")
  createdByUserId String
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  center        Center                 @relation(fields: [centerId], references: [id], onDelete: Cascade)
  topic         Topic?                 @relation(fields: [topicId], references: [id], onDelete: SetNull)
  skill         Skill?                 @relation(fields: [skillId], references: [id], onDelete: SetNull)
  targetStudent User?                  @relation("AssignmentTarget", fields: [targetStudentId], references: [id], onDelete: SetNull)
  createdBy     User                   @relation("AssignmentCreatedBy", fields: [createdByUserId], references: [id])
  submissions   AssignmentSubmission[]
  nextSteps     NextStep[]

  @@index([centerId, isActive, dueAt])
  @@map("assignments")
}

model Skill {
  id                     String @id @default(cuid())
  key                    String @unique
  name                   String
  description            String
  topicId                String
  order                  Int
  remediationTitle       String
  remediationDescription String

  topic         Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  prerequisites SkillDependency[]  @relation("SkillPrereqs")
  requiredBy    SkillDependency[]  @relation("SkillRequiredBy")
  errorPatterns ErrorPattern[]
  studentSkills StudentSkill[]
  histories     SkillHistory[]
  nextSteps     NextStep[]
  assignments   Assignment[]
  interviews    InterviewSession[]

  @@index([topicId])
  @@map("skills")
}

model SkillDependency {
  skillId             String
  prerequisiteSkillId String

  skill        Skill @relation("SkillPrereqs", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisite Skill @relation("SkillRequiredBy", fields: [prerequisiteSkillId], references: [id], onDelete: Cascade)

  @@id([skillId, prerequisiteSkillId])
  @@map("skill_dependencies")
}

model ErrorPattern {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  skillId     String

  skill           Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  studentPatterns StudentPattern[]

  @@map("error_patterns")
}

model StudentSkill {
  id              String    @id @default(cuid())
  centerId        String
  studentId       String
  skillId         String
  masteryScore    Int       @default(50)
  confidence      Float     @default(0)
  attempts        Int       @default(0)
  correctAttempts Int       @default(0)
  lastActivityAt  DateTime?
  updatedAt       DateTime  @updatedAt

  center  Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
  @@index([centerId, studentId])
  @@map("student_skills")
}

model StudentPattern {
  id             String        @id @default(cuid())
  centerId       String
  studentId      String
  patternId      String
  occurrences    Int           @default(0)
  resolvedCount  Int           @default(0)
  status         PatternStatus @default(ACTIVE)
  lastDetectedAt DateTime
  updatedAt      DateTime      @updatedAt

  center  Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pattern ErrorPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([studentId, patternId])
  @@index([centerId, studentId, status])
  @@map("student_patterns")
}

model SkillHistory {
  id                 String             @id @default(cuid())
  centerId           String
  studentId          String
  skillId            String
  previousScore      Int
  newScore           Int
  source             SkillHistorySource
  label              String
  sourceSubmissionId String?
  sourceAttemptId    String?
  createdAt          DateTime           @default(now())

  center  Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([centerId, studentId, createdAt])
  @@map("skill_histories")
}

/// AI texnik intervyu sessiyasi. Savol-javoblar InterviewTurn[] JSON shaklida saqlanadi.
model InterviewSession {
  id            String          @id @default(cuid())
  centerId      String
  studentId     String
  skillId       String?
  track         String          @default("frontend")
  level         String
  status        InterviewStatus @default(IN_PROGRESS)
  questionCount Int             @default(5)
  turns         Json            @default("[]")
  score         Int?
  summary       String?
  strengths     Json            @default("[]")
  weaknesses    Json            @default("[]")
  masteryBefore Int?
  masteryAfter  Int?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  updatedAt     DateTime        @updatedAt

  center  Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([centerId, studentId, startedAt])
  @@map("interview_sessions")
}

model AssignmentSubmission {
  id               String           @id @default(cuid())
  centerId         String
  assignmentId     String
  studentId        String
  status           SubmissionStatus
  progress         Int              @default(0)
  content          String           @default("")
  score            Int?
  feedback         String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  center     Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("SubmissionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([centerId, studentId, status])
  @@map("assignment_submissions")
}
