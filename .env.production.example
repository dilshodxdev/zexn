# docker-compose.prod.yml uchun. Serverga .env.production nomi bilan ko'chiriladi:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

POSTGRES_USER=zexn
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=zexn

# Server. DATABASE_URL compose ichida avtomatik yig'iladi (postgres:5432).
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://zexn.example.uz

# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# TELEGRAM_BOT_TOKEN=

# Client image build vaqtida. Bo'sh = /api (nginx proxy).
VITE_API_URL=

# Host'da nginx/caddy oldida tursa 127.0.0.1:8080 qoladi; to'g'ridan-to'g'ri ochish uchun 80.
HTTP_PORT=127.0.0.1:8080
